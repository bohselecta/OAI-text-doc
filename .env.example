# Local reference shell. No paid calls, accounts or credentials required.
PORT=4173
HOST=127.0.0.1
DOCUMENT_ORIGIN=http://127.0.0.1:4173
DOCUMENT_DB=./data/document.sqlite
DOCUMENT_AUTH=local
DOCUMENT_PROVIDER=rehearsal
# Live inference is opt-in and can incur API charges, separate from ChatGPT.
# DOCUMENT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=  # an enabled Responses/Structured Outputs model in YOUR project
# OPENAI_REVIEW_MODEL=  # defaults to OPENAI_MODEL
# Production requires a trusted issuer, audience, public key and HTTPS origin.
# NODE_ENV=production
# DOCUMENT_AUTH=jwt
# DOCUMENT_JWT_PUBLIC_KEY_FILE=/run/secrets/document-rs256-public.pem
# DOCUMENT_JWT_ISSUER=https://identity.example.com
# DOCUMENT_JWT_AUDIENCE=document
# DOCUMENT_ORIGIN=https://document.example.com
# HOST=0.0.0.0
