# Local reference shell. No paid calls, accounts or credentials required.
PORT=4173
HOST=127.0.0.1
DOCUMENT_ORIGIN=http://127.0.0.1:4173
DOCUMENT_DB=./data/document.sqlite
DOCUMENT_AUTH=local
DOCUMENT_PROVIDER=rehearsal
# Live inference is opt-in and can incur API charges, separate from ChatGPT.
# DOCUMENT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=  # an enabled Responses/Structured Outputs model in YOUR project
# OPENAI_REVIEW_MODEL=  # defaults to OPENAI_MODEL
# Production requires a trusted issuer, audience, public key and HTTPS origin.
# NODE_ENV=production
# DOCUMENT_AUTH=jwt
# DOCUMENT_JWT_PUBLIC_KEY_FILE=/run/secrets/document-rs256-public.pem
# DOCUMENT_JWT_ISSUER=https://identity.example.com
# DOCUMENT_JWT_AUDIENCE=document
# DOCUMENT_ORIGIN=https://document.example.com
# HOST=0.0.0.0

# Hosted Apps SDK + Vercel / Neon adapter only (npm run dev remains SQLite).
# Never put any value below in browser assets or commit real credentials.
# Set DOCUMENT_ORIGIN to the exact deployed HTTPS origin before hosted startup.
# DOCUMENT_ORIGIN=https://document.example.com
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DATABASE?sslmode=require
# Existing OAuth 2.1 authorization server: code+PKCE and CIMD or DCR.
# DOCUMENT_OAUTH_ISSUER=https://YOUR-IDENTITY-PROVIDER/
# DOCUMENT_OAUTH_JWKS_URL=https://YOUR-IDENTITY-PROVIDER/.well-known/jwks.json
# Optional; if supplied must be exactly DOCUMENT_ORIGIN + /mcp.
# DOCUMENT_OAUTH_AUDIENCE=https://document.example.com/mcp
# Tokens: RS256, exact issuer/audience, iat/exp <=1 hour, stable sub,
# scope="document:read document:write document:publish" for full authoring.
# Do not set DOCUMENT_AUTH=local on a hosted deployment; it is not supported.

# Additive whole-intention workspace (npm run dev:intention).
# It inherits PORT/DOCUMENT_ORIGIN above; override both to 4175 to run alongside Document.
# INTENTION_DB=./data/intentions.sqlite
